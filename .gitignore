# ═══════════════════════════════════════════════════════
# Segredos — NUNCA versionar
# ═══════════════════════════════════════════════════════
.env
# Cópias do banco. Levam dados de usuário dentro, inclusive CPF, e o
# repositório é público.
*.dump
*.sql.gz
.env.local
.env.*.local
# Qualquer copia do .env: backup de rotacao de chave, .env.old, .env.bak.
# O .env.example e a excecao, porque so tem nome de variavel.
.env.*
!.env.example
*.pem
*.key

# ═══════════════════════════════════════════════════════
# Python / FastAPI
# ═══════════════════════════════════════════════════════
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Testes e ferramentas
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ═══════════════════════════════════════════════════════
