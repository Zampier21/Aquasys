# ═══════════════════════════════════════════════════════
aquasys_app/.dart_tool/
aquasys_app/.flutter-plugins
aquasys_app/.flutter-plugins-dependencies
aquasys_app/.packages
aquasys_app/.pub-cache/
aquasys_app/.pub/
aquasys_app/build/
aquasys_app/coverage/
**/generated_plugin_registrant.dart
*.iml

# Builds por plataforma
aquasys_app/android/.gradle/
aquasys_app/android/app/debug/
aquasys_app/android/app/profile/
aquasys_app/android/app/release/
aquasys_app/android/local.properties
aquasys_app/android/key.properties
