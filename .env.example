# Copie para .env e preencha com os valores reais.
# O .env fica fora do git. Nunca comite credenciais.

# ─── Banco de dados ───────────────────────────────────
# Em servidor separado, acrescente ?sslmode=require: sem isso a senha e
# os dados dos clientes atravessam a rede em texto claro.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/AquaSys

# ─── JWT ──────────────────────────────────────────────
# Gere uma chave nova com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar esta chave invalida todos os tokens em circulação, ou seja,
# derruba a sessão de todo mundo. É de propósito: é o que se faz quando
# se suspeita que a chave vazou.
SECRET_KEY=troque-por-uma-chave-aleatoria-longa
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── YouTube (opcional) ───────────────────────────────
# Só o seed de cursos usa, no servidor. Nunca vai para o aplicativo.
# Restrinja a chave no Console do Google Cloud: limite à YouTube Data
# API v3 e ao IP do servidor. Chave sem restrição, se vazar, vira
# cobrança na sua conta.
YOUTUBE_API_KEY=

# ─── Aplicação ────────────────────────────────────────
APP_NAME=AquaSys
APP_VERSION=1.0.0

# 'desenvolvimento' | 'producao' | 'teste'
# Em 'producao' o servidor confere a configuração antes de subir e se
# recusa a ligar com chave de exemplo, DEBUG ligado ou CORS aberto.
AMBIENTE=desenvolvimento

# Liga detalhe interno nas respostas de erro. Jamais em produção.
DEBUG=True
# Despeja todo SQL no console — útil para depurar, ruidoso no dia a dia.
SQL_ECHO=False

# ─── Fronteira HTTP ───────────────────────────────────
# Origens de navegador autorizadas, separadas por vírgula. Vazio é o
# certo para API consumida só por aplicativo nativo. Em
# desenvolvimento, localhost já é liberado automaticamente em qualquer
# porta, porque o `flutter run -d chrome` sorteia a porta.
# Exemplo em produção: CORS_ORIGENS=https://app.aquasys.com.br
CORS_ORIGENS=

# A documentação interativa (/docs e /redoc) descreve todas as rotas e
# todos os campos. Vale ligar na sua máquina; em produção é mapa para
# quem está procurando por onde entrar.
DOCS_PUBLICOS=True

# Redireciona http para https e envia o cabeçalho HSTS. Ligar somente
# quando houver certificado, senão o redirecionamento não tem destino.
FORCAR_HTTPS=False

# Ligar apenas com proxy reverso na frente (Nginx, Caddy, balanceador).
# Ligado sem proxy, qualquer cliente escolhe o próprio endereço de
# origem pelo X-Forwarded-For e escapa do limite de requisições.
CONFIAR_NO_PROXY=False

# Teto do corpo da requisição, em bytes. O CSV de importação já tem
# limite próprio de 512 KB; este é o que impede o arquivo de chegar até
# lá. Padrão: 2 MB.
TAMANHO_MAXIMO_CORPO=2097152

# ─── Limite de requisições ────────────────────────────
RATE_LIMIT_ATIVO=True
# Teto geral por endereço, por minuto.
RATE_LIMIT_POR_MINUTO=120
# Teto de tentativas de login, por endereço e por documento, na janela
# abaixo. Baixo de propósito: é a única rota em que acertar vale uma
# conta. O acerto zera a contagem.
RATE_LIMIT_LOGIN=8
RATE_LIMIT_LOGIN_JANELA_SEGUNDOS=300
